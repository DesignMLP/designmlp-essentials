{
  "name": "designmlp/designmlp-essentials",
  "description": "Recurring fixes for DesignMLP websites, split into modules that can be enabled one by one.",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/DesignMLP/designmlp-essentials",
  "require": {
    "php": ">=8.2",
    "yahnis-elsts/plugin-update-checker": "^5.7"
  },
  "autoload": {
    "psr-4": {
      "DesignMLP\\Essentials\\": "includes/",
      "DesignMLP\\Essentials\\Modules\\": "modules/"
    }
  },
  "config": {
    "platform": {
      "php": "8.2"
    },
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.4"
  }
}
